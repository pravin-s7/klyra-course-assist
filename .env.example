# Required for multimodal document parsing (pdf/ppt/doc/docx) and for all
# agents' LLM calls, which are routed through LiteLLM as gemini/<model>.
# Get one at https://aistudio.google.com/ - never commit a real key here.
GEMINI_API_KEY=your-gemini-api-key-here

# A few embedding/knowledge code paths look for GOOGLE_API_KEY instead of
# GEMINI_API_KEY - set both to the same value to be safe.
GOOGLE_API_KEY=your-gemini-api-key-here

# Only needed if you set EMBEDDING_PROVIDER=openai below.
OPENAI_API_KEY=

# default = local, no API key needed (chromadb's built-in MiniLM model).
# openai  = higher-quality embeddings via OPENAI_API_KEY.
EMBEDDING_PROVIDER=default

# Where the local Chroma vector store is persisted.
KLYRA_CHROMA_DIR=.chroma

# Model used for multimodal document parsing and as the default LLM for all
# agents (see .cursor/rules/klyra.mdc). Routed through LiteLLM.
# NOTE: Pro-class Gemini models (incl. 3.1 Pro) have ZERO free-tier quota as
# of 2026. Full "Flash" models (2.5/3/3.5/3.7) are usually free-tier
# accessible but were observed capped at just 5 requests/minute on a real
# account - "Flash Lite" variants get 10-15 RPM instead (2-3x more headroom)
# for a similar model, which matters a lot when parsing multiple files back
# to back. gemini-3.1-flash-lite is confirmed multimodal (pdf/image/etc).
KLYRA_LLM_MODEL=gemini/gemini-3.1-flash-lite

# Model used specifically for the direct Gemini multimodal parsing calls
# (document_parser_tool). Usually the same model without the "gemini/" prefix.
KLYRA_PARSER_MODEL=gemini-3.1-flash-lite

# Minimum seconds between our own direct Gemini calls in document_parser_tool
# (not the agents' own LLM calls, which CrewAI retries on its own). Tuned for
# a 15 RPM budget (60/15=4s + buffer). Raise if you still see 429s, lower or
# set to 0 if your account has a higher tier.
KLYRA_PARSER_MIN_INTERVAL_SECONDS=5

# --- HTTP API (api/main.py, run via `klyra serve` or uvicorn) ---

# If set, every API request must send this back as the `X-API-Key` header.
# Leave empty for local/dev use with no auth (see PRODUCTION.md - do not
# leave this empty in a real deployment).
KLYRA_API_KEY=

# Per-client-IP limit applied to every job-creating POST route (not the
# cheap GET status/results routes). Uses slowapi's "N/period" syntax.
KLYRA_RATE_LIMIT=10/minute

# Comma-separated allowed browser origins for CORS, e.g.
# "https://app.example.com,https://staging.example.com". Empty = no browser
# origin is allowed to call this API directly (safest default - these
# endpoints trigger billed LLM calls).
KLYRA_CORS_ORIGINS=

# Where job records (status/result/error for every ingest/generate/revise/
# convert/teach/revise-teach/code/revise-code/transcript call made via the
# API) are persisted.
KLYRA_JOBS_DB=.klyra_jobs.sqlite3

# --- Coding problems (`klyra code`/`revise-code`) ---
#
# Needs a running Docker daemon on the host (`docker info` must succeed) -
# reference solutions and test cases are actually compiled/run in an
# isolated, network-disabled container per language, never just eyeballed
# by the LLM. Python/Java/C/C++ pull official images automatically; for
# --language bash, build the runner image once, ahead of time (package
# installs can't happen at container *run* time since runs are
# network-disabled):
#   docker build -t klyra-bash-runner:latest -f docker/bash-runner.Dockerfile docker/
# No env var here to configure - see PRODUCTION.md section 5 for the
# resource limits (timeout/memory/cpu) baked into code_execution_tool.py
# and the security tradeoffs of giving a containerized API access to launch
# sibling containers.

# --- Web app RBAC (klyra web) ---

# Password for the bootstrap 'admin' account created on first startup.
# If unset, a random password is generated and printed once to the console.
KLYRA_ADMIN_PASSWORD=

# Secret used to sign web session cookies. MUST be set in production
# (multi-worker/restart-safe logins). If unset, a per-process random secret
# is used (fine for local dev; logins reset on restart).
KLYRA_SESSION_SECRET=

# SQLite database for users/chat sessions/file ownership in local dev
# (defaults to .db/klyra.db). In production set DATABASE_URL (Postgres) —
# the same DATABASE_URL is shared with the job store.
KLYRA_DB=.db/klyra.db

# --- Google OAuth login (klyra web) ---
# Create an OAuth client at https://console.cloud.google.com/ (APIs & Services
# → Credentials → OAuth client ID, type "Web application"). Add your callback
# URL (e.g. http://localhost:8000/api/auth/google/callback) to "Authorized
# redirect URIs". Both values below are required to enable the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: override the callback URL (defaults to <request-base>/api/auth/google/callback,
# e.g. http://localhost:8000/api/auth/google/callback). Set this when running
# behind a proxy whose externally visible URL differs.
KLYRA_OAUTH_REDIRECT_URI=
# Auto-create a Klyra account (role=instructor, no courses) on first Google
# login. Set to 0 to require an admin-created account instead.
KLYRA_OAUTH_AUTO_PROVISION=1

# --- Voice CLI (`klyra voice`) ---

# Model for the Gemini Live API voice session. Must be a model that
# supports the Live (streaming) API. Check your available models at
# https://aistudio.google.com/.
KLYRA_VOICE_MODEL=gemini-3-flash-live

# Voice name for spoken output.
# Options: Puck, Charon, Kore, Fenrir, Aoede, Leda, Orus, Zephyr
KLYRA_VOICE_NAME=Puck
